# Copy to .env for local development: cp .env.example .env
# Every key and its default lives in backend/app/config.py.

# --- App ---
ENVIRONMENT=development
# Staging/production refuse to start with a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=30
CONSENT_POLICY_VERSION=2026-10-v1

# --- Database (PostgreSQL + PostGIS) ---
# Host is "db" inside docker compose; use localhost when running uvicorn directly.
DATABASE_URL=postgresql+asyncpg://carekin:carekin@db:5432/carekin

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Encryption ---
# Required in staging/production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# During a key rotation: the old key(s), comma-separated, still accepted for reading.
FIELD_ENCRYPTION_PREVIOUS_KEYS=

# --- Integrations ---
# true = NIN, background checks, escrow, payments, SMS and WhatsApp use mocks.
# In development the OTP is also returned in API responses as debug_code.
USE_MOCK_INTEGRATIONS=true
# SMS (OTPs and crisis alerts). Empty SMS_PROVIDER follows USE_MOCK_INTEGRATIONS:
# mock when true, termii when false. Production refuses mock.
# Termii's base URL is account-specific: copy it from the Termii dashboard.
# The sender ID (3-11 characters) must be approved for Termii's "dnd" channel.
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_BASE_URL=
SMS_SENDER_ID=CareKin
# NIN checks (ADR 0006). Unset NIN_PROVIDER follows USE_MOCK_INTEGRATIONS.
# NIN_PROVIDER=dojah calls Dojah even while the other partners are mocked.
NIN_PROVIDER=
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# Free sandbox with simulated records; live is https://api.dojah.io (charges the wallet).
DOJAH_BASE_URL=https://sandbox.dojah.io
BACKGROUND_CHECK_API_KEY=
ESCROW_PARTNER_API_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Paystack and Stripe send the payer back after checkout (?booking=<id> is added).
PAYMENT_RETURN_URL=http://localhost:3000/payments/return
# Paystack needs an email; users without one get <user id>@<this domain>. Use a real domain before live.
PAYMENT_EMAIL_DOMAIN=users.carekin.invalid
# CareKin's commission on each released booking, in basis points (100 = 1%). 0 until pricing is set.
PLATFORM_COMMISSION_BPS=0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta app secret: signs webhook calls (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Timeout for partner HTTP calls (NIN, escrow, payments, WhatsApp).
INTEGRATION_TIMEOUT_SECONDS=15

# --- Crisis button ---
EMERGENCY_NUMBER=112
CRISIS_FACILITY_RADIUS_KM=50
CRISIS_FACILITY_FALLBACK_RADIUS_KM=150
CRISIS_FACILITY_LIMIT=5
# A device GPS fix older than this (vs. the press) is flagged stale.
CRISIS_LOCATION_STALE_SECONDS=300
# A second press within this window returns the active crisis instead of re-alerting.
CRISIS_DUPLICATE_WINDOW_SECONDS=600
# Automatic retries per alert; POST /crisis/alert can always retry by hand.
CRISIS_ALERT_MAX_ATTEMPTS=3
CRISIS_ALERT_RETRY_AFTER_SECONDS=30

# --- Ops console ---
# A verified facility not re-checked for this many days goes back into the ops queue as "stale".
FACILITY_REVERIFY_AFTER_DAYS=90

# --- Storage ---
S3_BUCKET=
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for S3-compatible storage (MinIO, R2). Leave empty for AWS.
S3_ENDPOINT_URL=
S3_PRESIGN_EXPIRY_SECONDS=900
S3_MAX_UPLOAD_BYTES=10485760

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Local LLM (Ollama, in docker-compose) ---
# ollama = the real model (also locally); mock = canned replies, for tests only.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
