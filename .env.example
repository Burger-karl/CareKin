# Copy to .env for local development: cp .env.example .env
# Every key and its default lives in backend/app/config.py.

# --- App ---
ENVIRONMENT=development
# Staging/production refuse to start with a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=30
CONSENT_POLICY_VERSION=2026-10-v1

# --- Database (PostgreSQL + PostGIS) ---
# Host is "db" inside docker compose; use localhost when running uvicorn directly.
DATABASE_URL=postgresql+asyncpg://carekin:carekin@db:5432/carekin

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Encryption ---
# Required in staging/production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Integrations ---
# true = NIN, background checks, escrow, payments, SMS and WhatsApp use mocks.
# In development the OTP is also returned in API responses as debug_code.
USE_MOCK_INTEGRATIONS=true
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=CareKin
NIN_PROVIDER_API_KEY=
BACKGROUND_CHECK_API_KEY=
ESCROW_PARTNER_API_KEY=
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
LLM_API_KEY=

# --- Storage ---
S3_BUCKET=
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
